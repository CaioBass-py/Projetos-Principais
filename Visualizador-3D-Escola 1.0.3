        style.configure("Biblioteca.Treeview", background=self.SIDEBAR, foreground="#cbd5e1",
                        fieldbackground=self.SIDEBAR, borderwidth=0, rowheight=39,
                        font=("Segoe UI", 9))
        style.map("Biblioteca.Treeview", background=[("selected", "#202b3b")],
                  foreground=[("selected", "#f8fafc")])
        self.lista = ttk.Treeview(self.sidebar, style="Biblioteca.Treeview", show="tree",
                                  selectmode="browse", height=22)
        self.lista.pack(fill="both", expand=True)
        for categoria, nomes in self.categorias.items():
            cid = "categoria_" + categoria
            self.lista.insert("", "end", iid=cid, text=categoria.upper(), open=True, tags=("categoria",))
            for nome in nomes:
                self.lista.insert(cid, "end", iid=nome, text=f"   ◇   {nome}")
        self.lista.tag_configure("categoria", foreground="#71839e", font=("Segoe UI",8,"bold"))
