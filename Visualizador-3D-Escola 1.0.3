        self.cartao.place(x=20, y=20, width=410, height=202)
        cab = tk.Frame(self.cartao, bg="#101a29")
        cab.pack(fill="x")
        tk.Label(cab, text="●", bg="#101a29", fg=self.ACCENT,
                 font=("Segoe UI", 12)).pack(side="left", padx=(0,8))
