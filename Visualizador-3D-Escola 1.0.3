        }
        self.estatisticas = {
            "Tetraedro": ("4", "6", "4"), "Cubo": ("6", "12", "8"),
            "Octaedro": ("8", "12", "6"), "Dodecaedro": ("12", "30", "20"),
            "Icosaedro": ("20", "30", "12"), "Pirâmide": ("5", "8", "5"),
            "Prisma hexagonal": ("8", "18", "12"),
            "Esfera": ("1 superfície", "0", "0"),
            "Cilindro": ("3 superfícies", "2", "0"),
