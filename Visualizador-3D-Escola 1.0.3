            "Sólidos platônicos": ["Tetraedro", "Cubo", "Octaedro", "Dodecaedro", "Icosaedro"],
            "Prismas e pirâmides": ["Pirâmide", "Prisma hexagonal"],
            "Sólidos de revolução": ["Esfera", "Cilindro", "Cone"],
        }
        self.descricoes = {
            "Tetraedro": "Um sólido regular com quatro faces triangulares congruentes.",
            "Cubo": "Também chamado de hexaedro regular: seis quadrados iguais e ângulos retos.",
