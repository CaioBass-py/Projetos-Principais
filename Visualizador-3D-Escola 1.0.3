    BG = "#090e18"
    SIDEBAR = "#0c121e"
    PANEL = "#111a2a"
    TEXT = "#e8eef8"
    MUTED = "#8291a8"
    ACCENT = "#60a5fa"
    EDGE = "#dbeafe"
    OBJECT_COLOR = "#4388d0"

    def __init__(self, root):
