                                           command=self._centralizar, relief="flat",
                                           cursor="hand2", padx=12, pady=8,
                                           font=("Segoe UI",9,"bold"))
        self.botao_centralizar.pack(side="left", padx=2)
        self.botao_fullscreen = tk.Button(self.toolbar, text="⛶",
                                          command=self._alternar_tela_cheia, relief="flat",
                                          cursor="hand2", padx=10, pady=8,
                                          font=("Segoe UI",10,"bold"))
        self.botao_fullscreen.pack(side="left", padx=2)
        self._atualizar_botoes_modo()

    def _agendar_desenho(self, _evento=None):
        if self._resize_job:
            self.root.after_cancel(self._resize_job)
        self._resize_job = self.root.after(35, self._desenhar)

    def _atualizar_cartao(self):
        self.nome_card.configure(text=self.figura_atual)
        self.desc_card.configure(text=self.descricoes[self.figura_atual])
        for label, valor in zip(self.valores_stats, self.estatisticas[self.figura_atual]):
            label.configure(text=valor)

    def _definir_modo(self, modo):
        self.modo = modo
        self._atualizar_botoes_modo()
        self._desenhar()

    def _atualizar_botoes_modo(self):
        if not hasattr(self, "botoes_modo"):
            return
        for modo, botao in self.botoes_modo.items():
            escolhido = modo == self.modo
            botao.configure(bg="#34465e" if escolhido else "#152237",
                            fg="#f8fafc" if escolhido else "#98a8bf",
                            activebackground="#405571", activeforeground="white")
        for botao in (getattr(self, "botao_girar", None),
                      getattr(self, "botao_centralizar", None),
                      getattr(self, "botao_fullscreen", None)):
            if botao:
                botao.configure(bg="#152237", fg="#cbd5e1",
                                activebackground="#34465e", activeforeground="white")
        if hasattr(self, "botao_girar"):
            self.botao_girar.configure(text="⟳  Girando" if self.rotacao_automatica else "⟳  Girar",
                                       fg="#7dd3fc" if self.rotacao_automatica else "#cbd5e1")

    def _alternar_rotacao(self):
        self.rotacao_automatica = not self.rotacao_automatica
        self._atualizar_botoes_modo()

    def _animar(self):
        if self.rotacao_automatica:
            self.angulo_y += 0.012
            self._desenhar()
        self.root.after(33, self._animar)

    def _esta_tela_cheia(self):
        valor = self.root.attributes("-fullscreen")
        return str(valor).lower() in ("1", "true", "yes")

    def _alternar_tela_cheia(self, _evento=None):
        atual = self._esta_tela_cheia()
        self.root.attributes("-fullscreen", not atual)
        return "break"

    def _sair_tela_cheia(self, _evento=None):
        if self._esta_tela_cheia():
            self.root.attributes("-fullscreen", False)
            return "break"

    def _inicio_arrasto(self, evento):
        self.arrastando = True
        self.ultimo_mouse = (evento.x, evento.y)

    def _arrastar(self, evento):
        if not self.arrastando:
            return
        x, y = self.ultimo_mouse
        self.angulo_y += (evento.x-x) * 0.0035
        self.angulo_x -= (evento.y-y) * 0.0035
        self.ultimo_mouse = (evento.x, evento.y)
        self._desenhar()

    def _scroll(self, evento):
        self._zoom(1.1 if evento.delta > 0 else 1/1.1)

    def _zoom(self, fator):
        self.zoom = max(0.4, min(2.8, self.zoom*fator))
        self._desenhar()

    def _selecionar_figura(self, _evento=None):
        escolha = self.lista.selection()
        if escolha and escolha[0] in self.formas:
            self.figura_atual = escolha[0]
            self._atualizar_cartao()
            self._desenhar()

    def _centralizar(self):
        self.angulo_x, self.angulo_y, self.zoom = -0.34, 0.54, 1.0
        self._desenhar()

    def _desenhar_chao(self, cx, cy, escala):
        limite, nivel, passos = 2.5, -1.25, 12
        def ponto(x, z):
            rx, ry, rz = self._transformar((x,nivel,z))
            pers = 4.5/(4.5+rz)
            return cx+rx*escala*pers, cy-ry*escala*pers
        for i in range(passos+1):
            val = -limite + 2*limite*i/passos
            cor = "#26364d" if i in (0,passos) else "#172438"
            a,b = ponto(val,-limite),ponto(val,limite)
            c,d = ponto(-limite,val),ponto(limite,val)
            self.canvas.create_line(*a,*b,fill=cor,width=1.5 if i in (0,passos) else 1)
            self.canvas.create_line(*c,*d,fill=cor,width=1.5 if i in (0,passos) else 1)
        o, x, z = ponto(0,0), ponto(limite,0), ponto(0,limite)
        self.canvas.create_line(*o,*x,fill="#a65e68",width=2,arrow="last")
        self.canvas.create_line(*o,*z,fill="#438e74",width=2,arrow="last")

    @staticmethod
    def _misturar_cor(base, intensidade):
        rgb = [int(base[i:i+2],16) for i in (1,3,5)]
        rgb = [max(0,min(255,int(c*intensidade))) for c in rgb]
        return "#" + "".join(f"{c:02x}" for c in rgb)

    def _sombra_face(self, face, vertices_transformados):
        a,b,c = (vertices_transformados[face[i]] for i in range(3))
        u = tuple(b[k]-a[k] for k in range(3))
        v = tuple(c[k]-a[k] for k in range(3))
        n = (u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0])
        mag = math.sqrt(sum(x*x for x in n)) or 1
        light = (0.35,0.75,-0.55)
        brilho = abs(sum(n[i]/mag*light[i] for i in range(3)))
        return self._misturar_cor(self.OBJECT_COLOR, 0.56 + 0.55*brilho)

    def _desenhar(self):
        if not hasattr(self, "canvas"):
            return
        self.canvas.delete("all")
        largura = max(self.canvas.winfo_width(), 320)
        altura = max(self.canvas.winfo_height(), 320)
        cx, cy = largura/2, altura*0.54
        escala = min(largura, altura)*0.31*self.zoom
        self._desenhar_chao(cx,cy,escala)

        vertices, faces = self.formas[self.figura_atual]
        transformados = [self._transformar(v) for v in vertices]
        projetados = []
        for x,y,z in transformados:
            pers = 4.5/(4.5+z)
            projetados.append((cx+x*escala*pers,cy-y*escala*pers))

        arestas = self._arestas(faces)
        if self.modo != "Aramado":
            ordenadas = sorted(faces,key=lambda f: sum(transformados[i][2] for i in f)/len(f),reverse=True)
            for face in ordenadas:
                coords = [v for i in face for v in projetados[i]]
                cor = self._sombra_face(face,transformados)
                if self.modo == "Translúcido":
                    self.canvas.create_polygon(*coords,fill=cor,outline="",stipple="gray50")
                else:
                    self.canvas.create_polygon(*coords,fill=cor,outline="")

        cor_aresta = "#c9e4ff" if self.modo == "Aramado" else "#d8eaff"
        largura_aresta = 1.7 if self.modo == "Aramado" else 1.15
        for a,b in arestas:
            self.canvas.create_line(*projetados[a],*projetados[b],fill=cor_aresta,
                                    width=largura_aresta,capstyle="round")
        for x,y in projetados:
            self.canvas.create_oval(x-2.2,y-2.2,x+2.2,y+2.2,fill="#93c5fd",outline="")
        self._atualizar_botoes_modo()


    def _transformar(self, vertice):
        x, y, z = vertice
        cy, sy = math.cos(self.angulo_y), math.sin(self.angulo_y)
        cx, sx = math.cos(self.angulo_x), math.sin(self.angulo_x)
        x, z = x*cy - z*sy, x*sy + z*cy
        y, z = y*cx - z*sx, y*sx + z*cx
        return x, y, z


def main():
    root = tk.Tk()
    Visualizador3D(root)
    root.mainloop()


if __name__ == "__main__":
    main()



