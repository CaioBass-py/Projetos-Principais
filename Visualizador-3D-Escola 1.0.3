        self.canvas.bind("<ButtonPress-1>", self._inicio_arrasto)
        self.canvas.bind("<B1-Motion>", self._arrastar)
        self.canvas.bind("<MouseWheel>", self._scroll)
        self.canvas.bind("<Button-4>", lambda _e: self._zoom(1.1))
        self.canvas.bind("<Button-5>", lambda _e: self._zoom(1/1.1))
        self.canvas.bind("<Configure>", self._agendar_desenho)

        # Cartão flutuante com descrição e propriedades do sólido selecionado.
